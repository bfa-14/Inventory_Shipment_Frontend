# The web container's configuration (see Dockerfile).
#
# Serves the React app from /srv and forwards /api and /health to the API, over plain HTTP on port 8080
# only. TLS and the public address belong to the edge proxy in Inventory_Shipment/deploy: it answers
# HTTPS for each environment (production, testing), sends /api and /health straight to that
# environment's API and everything else here. Port 8080 is what the edge proxy reaches, and what an SSH
# tunnel reaches too (see "Open the app through SSH" in deploy/README.md); docker-compose publishes it on
# the server's 127.0.0.1 only, never to the internet.
#
# API_UPSTREAM, APP_ENVIRONMENT and APP_SWITCH_URL come from the environment: deploy/.env through
# docker-compose.

# Headers for the pages and files of the app. The API's responses carry their own (it is stricter,
# and Cache-Control: no-store), so these are not applied to /api.
#
# style-src needs 'unsafe-inline': Mantine writes its CSS variables in a <style> element and many
# components set style="". Images come from the app itself, data: URIs (small bundled images) and
# blob: URLs (item pictures, downloads read through the API).
(app_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

# The app: the API routes, the bundles and the single-page app.
(app) {
	encode zstd gzip

	# The API: everything under /api, and the health probe. Behind the edge proxy these never get
	# here (it sends them to the API itself); through the SSH tunnel they do.
	@api path /api /api/* /health
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:8080}
	}

	# Which environment this copy of the app is, read once by the app at start-up (src/environment/):
	# the sign-in page's Production / Testing switch goes to switchUrl, and "testing" puts the TESTING
	# marker on every page. The values are fixed when Caddy starts, so a change needs a restart.
	# no-store: the answer must never outlive a change of either value.
	handle /environment.json {
		import app_headers
		header Content-Type "application/json"
		header Cache-Control "no-store"
		respond `{"environment":"{$APP_ENVIRONMENT:production}","switchUrl":"{$APP_SWITCH_URL:}"}` 200
	}

	# Vite's bundles have a content hash in their names: cached for a year, and a name that does not
	# exist (a tab still open on the previous version) is a 404 rather than index.html.
	handle /assets/* {
		import app_headers
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	# Everything else is the single-page app: the file when there is one (favicon.svg), otherwise
	# index.html, so a deep link - a bookmarked page, an approval link in an email - opens that page.
	# no-cache makes the browser check for a new index.html, i.e. a new version, on every load.
	handle {
		import app_headers
		header Cache-Control "no-cache"
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

# The only site: plain HTTP, for the edge proxy and the SSH tunnel (ssh -L 8080:localhost:8080 ...).
http://:8080 {
	import app
}
