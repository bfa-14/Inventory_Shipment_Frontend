# Development settings (loaded by `npm run dev`).

# The Vite dev server proxies /api and /health to this address (see vite.config.ts).
# Change it if the API runs on another port - see Inventory_Shipment.API/Properties/launchSettings.json.
VITE_API_PROXY_TARGET=https://localhost:7089

# Leave empty to go through the proxy above (recommended: no CORS, no certificate warnings).
# Set it (e.g. https://localhost:7089) to call the API directly; its Cors:AllowedOrigins must then include http://localhost:5173.
VITE_API_BASE_URL=
